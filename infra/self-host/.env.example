NIBOMO_DOMAIN=flashcards.example.com
POSTGRES_PASSWORD=
BACKEND_DB_PASSWORD=

# Set to the Portainer Docker host's LAN IP for a proxy using IP and port.
# Keep loopback when Nginx Proxy Manager reaches the backend on the Docker network.
NIBOMO_BIND_IP=127.0.0.1

# For a registry deployment, set both image references to the same release tag.
# NIBOMO_BACKEND_IMAGE=ghcr.io/your-account/flashcards-open-source-app-backend:self-host-tag
# NIBOMO_MIGRATE_IMAGE=ghcr.io/your-account/flashcards-open-source-app-migrate:self-host-tag
